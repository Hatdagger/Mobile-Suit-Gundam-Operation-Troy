# ---------------------------------------------------------------------------
# GAME FILES MUST NEVER BE COMMITTED.
# Everyone supplies their own copy of the game. These rules keep game code,
# converted game code and game assets out of the repository.
# ---------------------------------------------------------------------------

# Your extracted game (default.xex, DLL modules, assets)
/game/
/assets/

# Converted (recompiled) game code produced by the build
/generated/*
!/generated/rexglue.cmake

# Any Xbox 360 executables, patches and disc/GOD images, wherever they are
*.xex
*.xexp
*.iso
*.xiso
*.god
Data[0-9][0-9][0-9][0-9]
*.data/

# Build output
/out/
/build/
/cmake-build-*/
/.cache/
compile_commands.json

# Runtime output written next to the executable
*.log
/saves/
/cache/

# The launcher, if you put it in this folder, and what it keeps beside itself
/*.exe
/RecompData/
/Saves/

# Editor / OS clutter
.vs/
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Python
__pycache__/
*.pyc
