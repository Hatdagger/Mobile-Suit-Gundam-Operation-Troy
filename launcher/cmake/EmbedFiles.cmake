# Turns files into byte arrays in one generated .cpp, so the launcher is a single .exe.
# Look them up at runtime with FindEmbeddedFile("name.ttf") (see src/util.h).

function(optroy_embed_files out_cpp)
    set(body "// Generated by launcher/cmake/EmbedFiles.cmake. Do not edit.\n#include <cstddef>\n#include <cstring>\n\n")
    set(table "")
    string(REPEAT "0x[0-9a-f][0-9a-f]," 24 row_pattern)
    foreach(file IN LISTS ARGN)
        get_filename_component(name "${file}" NAME)
        string(MAKE_C_IDENTIFIER "embedded_${name}" id)
        file(READ "${file}" hex HEX)
        string(LENGTH "${hex}" hex_len)
        math(EXPR size "${hex_len} / 2")
        string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
        string(REGEX REPLACE "(${row_pattern})" "\\1\n" bytes "${bytes}")
        string(APPEND body "static const unsigned char ${id}[] = {\n${bytes}\n};\n\n")
        string(APPEND table "    {\"${name}\", ${id}, ${size}},\n")
    endforeach()
    string(APPEND body
        "struct EmbeddedFileEntry { const char* name; const unsigned char* data; size_t size; };\n"
        "static const EmbeddedFileEntry kEmbeddedFiles[] = {\n${table}};\n\n"
        "const unsigned char* FindEmbeddedFile(const char* name, size_t* size) {\n"
        "    for (const auto& e : kEmbeddedFiles) {\n"
        "        if (std::strcmp(e.name, name) == 0) { if (size) *size = e.size; return e.data; }\n"
        "    }\n"
        "    if (size) *size = 0;\n"
        "    return nullptr;\n"
        "}\n")
    file(WRITE "${out_cpp}.tmp" "${body}")
    file(COPY_FILE "${out_cpp}.tmp" "${out_cpp}" ONLY_IF_DIFFERENT)
    file(REMOVE "${out_cpp}.tmp")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${ARGN})
endfunction()
